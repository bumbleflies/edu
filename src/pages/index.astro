---
const title = "edu.bumbleflies.de";
const courses = [
  {
    name: "Robot Explorer",
    tag: "Beginner · Block coding",
    age: "8–10 years",
    duration: "8 weeks · 1×/week · 60–75 min",
    blurb:
      "Build your first mbot and make it come alive with colorful drag-and-drop blocks. No experience needed.",
    outcomes: ["Logic & sequencing", "Loops & conditionals", "Line-following robot"],
    cta: "Start exploring",
  },
  {
    name: "Code the Machine",
    tag: "Intermediate · Python",
    age: "11–14 years",
    duration: "10 weeks · 1×/week · 90 min",
    blurb:
      "Level up from blocks to real Python and command your robot through sensors, lights and sound.",
    outcomes: ["Real Python code", "Sensors & IoT", "Autonomous maze robot"],
    cta: "Code the machine",
  },
];
const steps = [
  { title: "Build", text: "Snap your mbot together and wire up the sensors." },
  { title: "Code", text: "Drag blocks or write Python to tell it what to do." },
  { title: "Go", text: "Hit run and watch your ideas roll across the floor." },
];
const testimonials = [
  {
    quote: "My daughter built her first obstacle-avoiding robot after four weeks — she couldn't stop smiling.",
    name: "Anna, mum of Mia (9)",
  },
  {
    quote: "The Python course finally made coding click for my son. He's now building his own maze solver.",
    name: "Tom, dad of Leo (13)",
  },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Coding & robots for kids</title>
    <meta
      name="description"
      content="Bumble Academy — hands-on programming and robotics courses for kids 8–14 using the mbot platform."
    />
    <style>
      :root {
        --honey: #ffc93c;
        --honey-deep: #f5a623;
        --ink: #2b2b33;
        --muted: #6b6b76;
        --cream: #fffaf0;
        --coral: #ff7a59;
        --card: #ffffff;
        --radius: 20px;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: "Segoe UI", system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif;
        color: var(--ink);
        background: var(--cream);
        line-height: 1.55;
      }
      .wrap { max-width: 1080px; margin: 0 auto; padding: 0 24px; }
      section { padding: 72px 0; }
      h1, h2, h3 { line-height: 1.15; margin: 0 0 12px; }
      .eyebrow {
        display: inline-block;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-size: 0.8rem;
        color: var(--honey-deep);
        margin-bottom: 12px;
      }

      header.site { padding: 18px 0; }
      .nav { display: flex; align-items: center; justify-content: space-between; }
      .logo { font-weight: 800; font-size: 1.25rem; display: flex; align-items: center; gap: 10px; }
      .logo-bee {
        display: inline-grid; place-items: center;
        width: 40px; height: 40px; border-radius: 50%;
        background: linear-gradient(135deg, var(--honey), var(--honey-deep));
        font-size: 1.3rem;
      }
      .nav-links { display: flex; gap: 22px; }
      .nav-links a { color: var(--ink); text-decoration: none; font-weight: 600; }
      .nav-links a:hover { color: var(--honey-deep); }
      .btn {
        display: inline-block;
        padding: 14px 26px;
        border-radius: 999px;
        font-weight: 700;
        text-decoration: none;
        border: 0;
        cursor: pointer;
      }
      .btn-primary { background: var(--ink); color: var(--honey); }
      .btn-honey { background: var(--honey); color: var(--ink); }
      .btn:hover { transform: translateY(-2px); }
      .btn { transition: transform 0.15s ease; }

      .hero { padding-top: 40px; padding-bottom: 72px; }
      .hero-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 40px; align-items: center; }
      .hero h1 { font-size: clamp(2.4rem, 5vw, 3.6rem); }
      .hero h1 .pop { color: var(--honey-deep); }
      .hero p { font-size: 1.15rem; color: var(--muted); max-width: 30rem; }
      .hero-cta { margin-top: 24px; display: flex; gap: 14px; flex-wrap: wrap; }
      .hero-robot {
        position: relative;
        font-size: 8rem;
        text-align: center;
        line-height: 1;
      }
      .badge {
        position: absolute; top: 0; right: 0;
        background: var(--coral); color: #fff;
        font-weight: 700; font-size: 0.85rem;
        padding: 10px 16px; border-radius: 999px;
        transform: rotate(4deg);
      }

      .age-strip { background: var(--ink); color: var(--cream); }
      .age-strip h2 { color: var(--honey); }
      .age-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 28px; }
      .age-card { background: rgba(255,255,255,0.06); border-radius: var(--radius); padding: 22px; }
      .age-card .range { font-size: 1.6rem; font-weight: 800; color: var(--honey); }

      .course-card {
        background: var(--card);
        border-radius: var(--radius);
        padding: 28px;
        box-shadow: 0 8px 30px rgba(43,43,51,0.08);
        border-top: 6px solid var(--honey);
        display: flex; flex-direction: column; gap: 8px;
      }
      .course-card:nth-child(2) { border-top-color: var(--coral); }
      .course-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; margin-top: 32px; }
      .tag { font-weight: 700; color: var(--honey-deep); font-size: 0.85rem; letter-spacing: 0.04em; }
      .meta { color: var(--muted); font-size: 0.95rem; }
      .outcomes { list-style: none; padding: 0; margin: 12px 0; display: flex; flex-wrap: wrap; gap: 8px; }
      .outcomes li { background: var(--cream); border: 1px solid #f0e3c4; padding: 6px 12px; border-radius: 999px; font-size: 0.85rem; font-weight: 600; }
      .course-card .btn { align-self: flex-start; margin-top: auto; }

      .steps-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 32px; }
      .step { background: var(--card); border-radius: var(--radius); padding: 24px; box-shadow: 0 6px 20px rgba(43,43,51,0.06); }
      .step-num { font-size: 1.5rem; font-weight: 800; color: var(--honey-deep); }

      .why { background: var(--card); }
      .why-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 28px; }
      .why-item { padding: 18px; border: 1px solid #eee0c0; border-radius: var(--radius); }
      .why-item b { display: block; margin-bottom: 4px; }

      .testimonials { background: var(--ink); color: var(--cream); }
      .testimonials h2 { color: var(--honey); }
      .quote-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; margin-top: 28px; }
      .quote { background: rgba(255,255,255,0.06); border-radius: var(--radius); padding: 24px; }
      .quote p { font-size: 1.05rem; }
      .quote cite { display: block; margin-top: 10px; font-style: normal; color: var(--honey); font-weight: 700; }

      .cta { text-align: center; }
      .cta h2 { font-size: 2rem; }

      footer { padding: 28px 0; color: var(--muted); font-size: 0.9rem; }
      .foot { display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; border-top: 1px solid #eee0c0; padding-top: 20px; }

      @media (max-width: 760px) {
        .hero-grid, .course-grid, .quote-grid { grid-template-columns: 1fr; }
        .age-cards, .steps-grid, .why-list { grid-template-columns: 1fr; }
        .nav-links { display: none; }
      }
    </style>
  </head>
  <body>
    <header class="site wrap nav">
      <div class="logo"><span class="logo-bee">🐝</span> Bumble Academy</div>
      <nav class="nav-links">
        <a href="#courses">Courses</a>
        <a href="#how">How it works</a>
        <a href="#reviews">Reviews</a>
      </nav>
      <a class="btn btn-honey" href="#courses">Book a course</a>
    </header>

    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <span class="eyebrow">Kids 8–14 · mbot robotics</span>
          <h1>Build. Code.<br /><span class="pop">Make it move.</span></h1>
          <p>
            Hands-on programming and robotics courses where kids snap together an
            mbot, write real code, and watch their ideas roll across the room.
            No experience needed — just curiosity.
          </p>
          <div class="hero-cta">
            <a class="btn btn-primary" href="#courses">Browse courses</a>
            <a class="btn btn-honey" href="#how">How it works</a>
          </div>
        </div>
        <div class="hero-robot">
          <span class="badge">mbot</span>
          🤖
        </div>
      </div>
    </section>

    <section class="age-strip" id="ages">
      <div class="wrap">
        <span class="eyebrow">Age groups</span>
        <h2>We meet kids where they are</h2>
        <div class="age-cards">
          <div class="age-card">
            <div class="range">8–10</div>
            <p>Start with drag-and-drop blocks and your very first moving robot.</p>
          </div>
          <div class="age-card">
            <div class="range">10–12</div>
            <p>Mix blocks and text, tackle sensors, and take on mini challenges.</p>
          </div>
          <div class="age-card">
            <div class="range">12–14</div>
            <p>Dive into real Python and build autonomous, sensor-driven robots.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="courses">
      <div class="wrap">
        <span class="eyebrow">Our courses</span>
        <h2>Two paths, one great robot</h2>
        <div class="course-grid">
          {courses.map((c) => (
            <article class="course-card">
              <div class="tag">{c.tag}</div>
              <h3>{c.name}</h3>
              <p>{c.blurb}</p>
              <div class="meta">{c.age} · {c.duration}</div>
              <ul class="outcomes">
                {c.outcomes.map((o) => <li>{o}</li>)}
              </ul>
              <a class="btn btn-primary" href="#">{c.cta}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="how" class="why">
      <div class="wrap">
        <span class="eyebrow">How it works</span>
        <h2>From idea to rolling robot in three steps</h2>
        <div class="steps-grid">
          {steps.map((s, i) => (
            <div class="step">
              <div class="step-num">{i + 1}. {s.title}</div>
              <p>{s.text}</p>
            </div>
          ))}
        </div>
        <div class="why-list">
          <div class="why-item"><b>Small groups</b>Every kid gets a robot and personal attention.</div>
          <div class="why-item"><b>Real hardware</b>Learn with the mbot, a real coding robot.</div>
          <div class="why-item"><b>No experience needed</b>Start with blocks, grow into Python.</div>
          <div class="why-item"><b>Parents included</b>Progress updates and a final showcase.</div>
        </div>
      </div>
    </section>

    <section id="reviews" class="testimonials">
      <div class="wrap">
        <span class="eyebrow">Reviews</span>
        <h2>What families say</h2>
        <div class="quote-grid">
          {testimonials.map((t) => (
            <div class="quote">
              <p>“{t.quote}”</p>
              <cite>{t.name}</cite>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="cta">
      <div class="wrap">
        <h2>Ready to make something move?</h2>
        <p>Join a course and build your first coding robot this term.</p>
        <a class="btn btn-primary" href="#" style="margin-top: 12px;">Book a course</a>
      </div>
    </section>

    <footer class="wrap foot">
      <span>{title} · Bumble Academy</span>
      <span>Programming &amp; robotics for kids 8–14</span>
    </footer>
  </body>
</html>
