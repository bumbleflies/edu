---
import Layout from "../components/Layout.astro";
import ParentFlyer from "../components/ParentFlyer.astro";
import { content } from "../lib/content";
import { ui } from "../lib/i18n";
import "../styles/flyer.css";

const c = content.de;
const t = ui.de;
---
<Layout lang="de" altHref="/en/flyer" title={`${t.flyerTitle} · edu.bumbleflies.de`} description={c.description}>
  <div class="pf-actions no-print">
    <button type="button" id="print-btn">{t.flyerPrintButton}</button>
    <p class="pf-print-hint">{c.flyer.onePagePrintHint}</p>
  </div>
  <ParentFlyer lang="de" />
  <script>
    document.getElementById("print-btn")?.addEventListener("click", () => window.print());
  </script>
</Layout>
