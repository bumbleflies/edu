---
import Layout from "../../components/Layout.astro";
import { content } from "../../lib/content";
import { ui } from "../../lib/i18n";
import "../../styles/home.css";

const lang = "en" as const;
const c = content.en;
const t = ui.en;
---
<Layout lang={lang} altHref="/" title={c.title} description={c.description}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">{c.heroEyebrow}</span>
        <h1>{c.heroTitle}<br /><span class="pop">{c.heroTitlePop}</span></h1>
        <p>{c.heroSubtitle}</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#courses">{t.browseCourses}</a>
          <a class="btn btn-honey" href="#how">{t.howItWorks}</a>
        </div>
      </div>
      <div class="hero-art">
        <span class="badge">mbot</span>
        <img src="/images/hero.webp" width="1200" height="673" alt="Child playing with a friendly robot" />
      </div>
    </div>
  </section>

  <section class="age-strip" id="ages">
    <div class="wrap">
      <span class="eyebrow">Age groups</span>
      <h2>We meet kids where they are</h2>
      <div class="age-cards">
        {c.ageCards.map((a) => (
          <div class="age-card">
            <div class="range">{a.range}</div>
            <p>{a.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="courses">
    <div class="wrap">
      <span class="eyebrow">Our courses</span>
      <h2>Two paths, one great robot</h2>
      <div class="course-grid">
        {c.courses.map((course) => (
          <article class="course-card">
            {course.icon === "blocks" ? (
              <svg class="icon" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="4" y="4" width="14" height="14" rx="4" fill="var(--accent)" />
                <rect x="22" y="4" width="14" height="14" rx="4" fill="var(--signal)" opacity="0.85" />
                <rect x="4" y="22" width="14" height="14" rx="4" fill="var(--signal)" opacity="0.6" />
                <rect x="22" y="22" width="14" height="14" rx="4" fill="var(--accent)" opacity="0.6" />
              </svg>
            ) : (
              <svg class="icon" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M13 12 4 20l9 8" stroke="var(--signal)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M27 12l9 8-9 8" stroke="var(--accent-deep)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M23 8 17 32" stroke="var(--ink)" stroke-width="3" stroke-linecap="round" />
              </svg>
            )}
            <img class="card-img" src={course.image} width="900" height="600" alt={course.name} />
            <div class="tag">{course.tag}</div>
            <h3>{course.name}</h3>
            <p>{course.blurb}</p>
            <div class="meta">{course.age} · {course.duration}</div>
            <ul class="outcomes">
              {course.outcomes.map((o) => <li>{o}</li>)}
            </ul>
            <a class="btn btn-primary" href={course.href}>{course.cta}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="how" class="why">
    <div class="wrap">
      <span class="eyebrow">{t.navHow}</span>
      <h2>From idea to rolling robot in three steps</h2>
      <div class="steps-grid">
        {c.steps.map((step, i) => (
          <div class="step">
            {step.icon === "build" && (
              <svg class="icon" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="6" y="16" width="24" height="14" rx="4" fill="var(--accent)" />
                <rect x="12" y="6" width="12" height="12" rx="3" fill="var(--signal)" />
              </svg>
            )}
            {step.icon === "code" && (
              <svg class="icon" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M12 10 4 18l8 8" stroke="var(--signal)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M24 10l8 8-8 8" stroke="var(--accent-deep)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            {step.icon === "go" && (
              <svg class="icon" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M7 18h18m0 0-7-7m7 7-7 7" stroke="var(--accent-deep)" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="30" cy="18" r="3" fill="var(--signal)" />
              </svg>
            )}
            <div class="step-num">{i + 1}. {step.title}</div>
            <p>{step.text}</p>
          </div>
        ))}
      </div>
      <div class="why-list">
        {c.whyList.map((w) => (
          <div class="why-item"><b>{w.title}</b>{w.text}</div>
        ))}
      </div>
    </div>
  </section>

  <section id="trainers" class="trainers">
    <div class="wrap">
      <span class="eyebrow">{c.trainersEyebrow}</span>
      <h2>{c.trainersTitle}</h2>
      <div class="trainer-grid">
        {c.trainers.map((trainer) => (
          <article class="trainer-card">
            <img class="avatar" src={trainer.image} width="240" height="240" alt={trainer.name} loading="lazy" />
            <div>
              <h3>{trainer.name}</h3>
              <div class="trainer-role">{trainer.role}</div>
              <p>{trainer.blurb}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="reviews" class="testimonials">
    <div class="wrap">
      <span class="eyebrow">{t.navReviews}</span>
      <h2>What families say</h2>
      <p class="disclaimer">{c.testimonialsDisclaimer}</p>
      <div class="quote-grid">
        {c.testimonials.map((testimonial) => (
          <div class="quote">
            <p>“{testimonial.quote}”</p>
            <cite>{testimonial.name}</cite>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <h2>{c.ctaTitle}</h2>
      <p>{c.ctaSubtitle}</p>
      <a class="btn btn-primary" href="#courses" style="margin-top: 12px;">{t.bookCourse}</a>
    </div>
  </section>
</Layout>
