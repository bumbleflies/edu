---
import Layout from "../../components/Layout.astro";
import TriFoldFlyer from "../../components/TriFoldFlyer.astro";
import { content } from "../../lib/content";
import { ui } from "../../lib/i18n";
import "../../styles/flyer.css";

const c = content.en;
const t = ui.en;
---
<Layout lang="en" altHref="/flyer" title={`${t.flyerTitle} · edu.bumbleflies.de`} description={c.description}>
  <div class="flyer-actions no-print">
    <button type="button" id="print-btn">{t.flyerPrintButton}</button>
    <p class="flyer-print-hint">{c.flyer.printHint}</p>
  </div>
  <TriFoldFlyer lang="en" />
  <script>
    document.getElementById("print-btn")?.addEventListener("click", () => window.print());
  </script>
</Layout>
