<span class="bf-mark" aria-hidden="true"></span>
<style>
  .bf-mark {
    width: 30px;
    height: 30px;
    position: relative;
    flex-shrink: 0;
  }
  .bf-mark::before,
  .bf-mark::after {
    content: "";
    position: absolute;
    border-radius: 50%;
  }
  .bf-mark::before {
    width: 18px;
    height: 18px;
    background: var(--accent);
    transform: translate(2px, 6px);
  }
  .bf-mark::after {
    width: 13px;
    height: 13px;
    background: var(--signal);
    mix-blend-mode: multiply;
    opacity: 0.9;
    transform: translate(11px, 2px);
  }
</style>
